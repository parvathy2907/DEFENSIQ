---
interface Props {
  title: string;
  figureNumber?: string;
  caption?: string;
  status?: string;
}

const { title, figureNumber, caption, status } = Astro.props;
---

<figure class="workflow-diagram-container">
  <div class="workflow-header">
    <h4 class="workflow-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="3" y1="9" x2="21" y2="9"></line>
        <line x1="9" y1="21" x2="9" y2="9"></line>
      </svg>
      {figureNumber ? `${figureNumber} · ${title}` : title}
    </h4>
    {status && <span class="workflow-status">{status}</span>}
  </div>
  <div class="workflow-body">
    <slot />
  </div>
  {caption && <figcaption class="workflow-caption"><strong>{figureNumber ?? 'Figure'}</strong> {caption}</figcaption>}
</figure>
