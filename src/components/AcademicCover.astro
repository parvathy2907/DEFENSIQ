---
const stages = [
  {
    n: 'I', cls: 's1', title: 'Behavioural Data Acquisition', href: '/methodology/cuckoo-sandbox/',
    items: ['≈ 3,000 samples from VirusShare and VirusTotal', 'SHA-256 de-duplication, AV-engine labels', 'Cuckoo Sandbox → triggered signatures Sₕ'],
  },
  {
    n: 'II', cls: 's2', title: 'Impact & ATT&CK–D3FEND Mapping', href: '/methodology/impact-quantification/',
    items: ['MAGIC impact score Aₖ ∈ [1, 35]', 'Technique → mitigation → D3FEND pool Pₖ', 'Candidate dataset: 17 samples, 2,823 rows'],
  },
  {
    n: 'III', cls: 's3', title: 'Cooperative Co-Evolutionary Optimisation', href: '/methodology/ccea/',
    items: ['One sub-population per signature', 'Reduced severity RS ∈ [0, 10] (CSV or LLM)', 'F(C) = (IS − RA) / IS, credit assignment, elitism'],
  },
  {
    n: 'IV', cls: 's4', title: 'Output & Evaluation', href: '/evaluation/evaluation-plan/',
    items: ['Optimal defense strategy C*, fitness F*', 'Malware Severity Score before and after', 'Greedy baseline, Shapiro–Wilk, Wilcoxon (α = 0.05)'],
  },
];

const groups = [
  { tag: 'A', cls: 'g-a', title: 'Project Overview', desc: 'Ransomware background, problem statement, objectives and the security problems addressed.', href: '/overview/introduction/', pages: 3 },
  { tag: 'B', cls: 'g-b', title: 'Related Work & Research Gap', desc: 'Ten core studies, the foundations used, and how the gap moved from detection to defense selection.', href: '/research/literature-review/', pages: 2 },
  { tag: 'C', cls: 'g-c', title: 'System & Methodology', desc: 'From Phase 1 to Phase 2, the architecture, and every stage from sandbox to CCEA.', href: '/methodology/evolution/', pages: 10 },
  { tag: 'D', cls: 'g-d', title: 'Evaluation', desc: 'Malware Severity Score, greedy baseline, statistical tests and residual-severity metrics.', href: '/evaluation/evaluation-plan/', pages: 1 },
  { tag: 'E', cls: 'g-e', title: 'Discussion & Resources', desc: 'Limitations, future work, the full reference list and the team.', href: '/resources/limitations-future-work/', pages: 3 },
];

const team = [
  ['CB.SC.U4CSE23720', 'Guru D', 'GD'],
  ['CB.SC.U4CSE23739', 'Parvathy Krishna A', 'PK'],
  ['CB.SC.U4CSE23743', 'Shivanesh M C', 'SM'],
  ['CB.SC.U4CSE23755', 'Vijeya Varshini G', 'VV'],
  ['CB.SC.U4CSE23758', 'Vimal Sabari S B', 'VS'],
];
---

<div class="cover not-content">
  <!-- Hero -->
  <header class="hero">
    <div class="hero-main">
      <div class="strip">
        <span class="pill">Team 42</span>
        <span>B.Tech CSE · Batch 2023–2027</span>
        <span>Knowledge Engineering &amp; Semantic Computing</span>
      </div>
      <h1>An Evolutionary Framework for <em>Ransomware Defense</em> Optimization</h1>
      <p class="lede">The framework turns observed ransomware behavior into a recommended set of defenses. It records what a sample does in a sandbox, scores the impact of each behavior, and maps it through MITRE ATT&amp;CK techniques and mitigations to candidate D3FEND defenses. A cooperative co-evolutionary search then finds the combination that leaves the least severity behind.</p>
      <div class="actions">
        <a class="btn primary" href="/overview/introduction/">Read the documentation →</a>
        <a class="btn" href="/methodology/architecture/">View the architecture</a>
      </div>
    </div>

    <aside class="hero-card" aria-label="Project details">
      <div class="dq-logo-chip"><img src="/images/amrita-logo-full.png" alt="Amrita Vishwa Vidyapeetham" /></div>
      <dl class="hc-list">
        <div><dt>Department</dt><dd>Computer Science &amp; Engineering, Coimbatore</dd></div>
        <div><dt>Guide</dt><dd>Ms. Rohini S <span>Assistant Professor</span></dd></div>
        <div><dt>Co-guide</dt><dd>Dr. Gowtham R <span>Associate Professor</span></dd></div>
        <div><dt>Academic years</dt><dd>2025–26 (Phase 1) · 2026–27 (Phase 2)</dd></div>
      </dl>
    </aside>
  </header>

  <!-- Key figures -->
  <dl class="facts">
    <div class="f1"><dt>Samples collected</dt><dd>≈ 3,000</dd></div>
    <div class="f2"><dt>Candidate dataset</dt><dd>17 samples · 2,823 rows</dd></div>
    <div class="f3"><dt>Impact scale</dt><dd>Aₖ ∈ [1, 35]</dd></div>
    <div class="f4"><dt>Reduced severity</dt><dd>RS ∈ [0, 10]</dd></div>
  </dl>

  <!-- Architecture at a glance -->
  <section class="glance">
    <div class="sec-head">
      <h2 class="sec-h">Architecture at a glance</h2>
      <a class="sec-link" href="/methodology/architecture/">Full architecture →</a>
    </div>
    <a class="dq-diagram fit glance-fig" href="/methodology/architecture/" aria-label="Open the System Architecture page">
      <img class="img-light" src="/images/architecture.png" alt="Four-stage framework architecture: behavioural data acquisition; impact quantification and ATT&CK–D3FEND mapping; cooperative co-evolutionary defense optimisation with the Reduced_Severity module; output and evaluation." loading="lazy" />
    <img class="img-dark" src="/images/architecture-dark.png" alt="Four-stage framework architecture: behavioural data acquisition; impact quantification and ATT&CK–D3FEND mapping; cooperative co-evolutionary defense optimisation with the Reduced_Severity module; output and evaluation." loading="lazy" />
    </a>
  </section>

  <!-- Stages -->
  <section>
    <h2 class="sec-h">Four stages</h2>
    <ol class="stages">
      {stages.map((s) => (
        <li class:list={['stage', s.cls]}>
          <a href={s.href}>
            <span class="st-n">Stage {s.n}</span>
            <span class="st-t">{s.title}</span>
            <ul>
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Documentation groups -->
  <section>
    <h2 class="sec-h">Documentation</h2>
    <div class="group-grid">
      {groups.map((g) => (
        <a class:list={['group', g.cls]} href={g.href}>
          <span class="g-tag"><b>{g.tag}</b> {g.pages} {g.pages === 1 ? 'page' : 'pages'}</span>
          <span class="g-title">{g.title}</span>
          <span class="g-desc">{g.desc}</span>
          <span class="g-go">Open section →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Team -->
  <section>
    <h2 class="sec-h">Team</h2>
    <ul class="team">
      {team.map(([reg, name, ini], i) => (
        <li class:list={['member', `m${i + 1}`]}>
          <span class="avatar" aria-hidden="true">{ini}</span>
          <span class="m-name">{name}</span>
          <span class="m-reg">{reg}</span>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .cover { max-width: 74rem; margin: 0 auto; padding: 0.5rem 0 2rem; color: var(--dq-text); }

  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; padding: 2.5rem 0 2.25rem; }
  .strip { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem 1rem; font-family: var(--dq-label); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dq-muted); }
  .pill { background: linear-gradient(90deg, var(--dq-signal), var(--dq-violet)); color: var(--dq-on-signal); padding: 0.3rem 0.6rem; border-radius: 999px; font-weight: 600; }
  h1 { font-family: var(--dq-display); font-size: clamp(2.1rem, 5vw, 3.5rem); line-height: 1.06; font-weight: 700; color: var(--dq-bright); margin: 1.1rem 0 1rem; text-wrap: balance; }
  h1 em { font-style: normal; background: linear-gradient(90deg, var(--dq-signal), var(--dq-violet)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { font-size: 1.1rem; line-height: 1.65; max-width: 62ch; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .btn { display: inline-flex; align-items: center; font-family: var(--dq-label); font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; padding: 0.75rem 1.05rem; border-radius: 6px; border: 1px solid var(--dq-line); color: var(--dq-bright); background: var(--dq-panel); }
  .btn:hover { border-color: var(--dq-signal); }
  .btn.primary { background: var(--dq-signal); border-color: var(--dq-signal); color: var(--dq-on-signal); font-weight: 600; box-shadow: 0 8px 24px -10px var(--dq-signal); }
  .btn.primary:hover { filter: brightness(1.07); }

  .hero-card { display: flex; flex-direction: column; gap: 1.1rem; padding: 1.4rem; border: 1px solid var(--dq-line); border-radius: 12px; background: var(--dq-panel); box-shadow: 0 20px 50px -30px rgba(15, 26, 46, 0.45); position: relative; overflow: hidden; }
  .hero-card::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg, var(--dq-signal), var(--dq-violet), var(--dq-blue)); }
  .hero-card .dq-logo-chip { align-self: flex-start; }
  .hc-list { margin: 0; display: grid; gap: 0.75rem; }
  .hc-list div { display: grid; gap: 0.15rem; }
  .hc-list dt { font-family: var(--dq-label); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dq-muted); }
  .hc-list dd { margin: 0; font-family: var(--dq-display); font-weight: 600; color: var(--dq-bright); }
  .hc-list dd span { display: block; font-family: var(--sl-font); font-weight: 400; font-size: 0.85rem; color: var(--dq-muted); }

  /* Facts */
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin: 0; }
  .facts div { background: var(--dq-panel); border: 1px solid var(--dq-line); border-radius: 10px; padding: 1rem 1.1rem; border-top: 3px solid var(--c); }
  .facts .f1 { --c: var(--dq-g-a); } .facts .f2 { --c: var(--dq-g-b); } .facts .f3 { --c: var(--dq-g-c); } .facts .f4 { --c: var(--dq-g-e); }
  .facts dt { font-family: var(--dq-label); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dq-muted); }
  .facts dd { margin: 0.4rem 0 0; font-family: var(--dq-display); font-weight: 700; font-size: 1.2rem; color: var(--dq-bright); }

  /* Section headings */
  section { margin-top: 3.25rem; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .sec-h { font-family: var(--dq-display); font-size: 1.45rem; font-weight: 700; color: var(--dq-bright); margin: 0 0 1rem; padding: 0; border: none; }
  .sec-h::after { content: ''; display: block; width: 56px; height: 3px; margin-top: 0.45rem; border-radius: 2px; background: linear-gradient(90deg, var(--dq-signal), var(--dq-violet)); }
  .sec-link { font-family: var(--dq-label); font-size: 0.78rem; color: var(--dq-signal); text-decoration: none; }

  .glance-fig { border: 1px solid var(--dq-line); border-radius: 12px; }

  /* Stages */
  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.85rem; counter-reset: none; }
  .stage { margin: 0; }
  .stage a { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding: 1.1rem 1.1rem 1.2rem; border: 1px solid var(--dq-line); border-radius: 12px; background: var(--dq-panel); text-decoration: none; color: var(--dq-text); position: relative; overflow: hidden; }
  .stage a::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--c); }
  .stage a:hover { border-color: var(--c); }
  .s1 { --c: var(--dq-g-a); } .s2 { --c: var(--dq-g-b); } .s3 { --c: var(--dq-g-c); } .s4 { --c: var(--dq-g-e); }
  .st-n { font-family: var(--dq-label); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c); font-weight: 600; }
  .st-t { font-family: var(--dq-display); font-weight: 700; font-size: 1.05rem; line-height: 1.25; color: var(--dq-bright); }
  .stage ul { margin: 0.25rem 0 0; padding-left: 1rem; font-size: 0.86rem; line-height: 1.5; }
  .stage ul li { margin: 0.2rem 0; }
  .stage ul li::marker { color: var(--c); }

  /* Groups */
  .group-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.85rem; }
  .group { display: flex; flex-direction: column; gap: 0.45rem; padding: 1.1rem; border: 1px solid var(--dq-line); border-radius: 12px; background: var(--dq-panel); text-decoration: none; color: var(--dq-text) !important; border-top: 3px solid var(--g); }
  .group:hover { box-shadow: 0 12px 30px -18px var(--g); }
  .g-a { --g: var(--dq-g-a); } .g-b { --g: var(--dq-g-b); } .g-c { --g: var(--dq-g-c); } .g-d { --g: var(--dq-g-d); } .g-e { --g: var(--dq-g-e); }
  .g-tag { font-family: var(--dq-label); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dq-muted); display: flex; align-items: center; gap: 0.5rem; }
  .g-tag b { display: inline-grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 5px; background: var(--g); color: var(--dq-on-signal); }
  .g-title { font-family: var(--dq-display); font-weight: 700; font-size: 1.08rem; color: var(--dq-bright); }
  .g-desc { font-size: 0.88rem; line-height: 1.5; flex: 1; color: var(--dq-text); }
  .g-go { font-family: var(--dq-label); font-size: 0.74rem; color: var(--g); }

  /* Team */
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; }
  .member { margin: 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; padding: 1.1rem 0.75rem; border: 1px solid var(--dq-line); border-radius: 12px; background: var(--dq-panel); }
  .avatar { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; font-family: var(--dq-display); font-weight: 700; color: var(--dq-on-signal); background: var(--c); }
  .m1 { --c: var(--dq-g-a); } .m2 { --c: var(--dq-g-b); } .m3 { --c: var(--dq-g-c); } .m4 { --c: var(--dq-g-e); } .m5 { --c: var(--dq-g-d); }
  .m-name { font-family: var(--dq-display); font-weight: 600; color: var(--dq-bright); line-height: 1.25; }
  .m-reg { font-family: var(--dq-label); font-size: 0.72rem; color: var(--dq-muted); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-top: 1.25rem; }
    .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .team { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stages { grid-template-columns: minmax(0, 1fr); }
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
