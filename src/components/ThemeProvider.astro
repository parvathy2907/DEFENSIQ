---
// Applies the saved theme before first paint. With no saved choice the site
// opens in the light theme; 'auto' follows the operating-system setting.
---

<script is:inline>
	window.StarlightThemeProvider = (() => {
		let stored = null;
		try { stored = localStorage.getItem('starlight-theme'); } catch (e) {}
		const system = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		const theme = stored === 'dark' ? 'dark' : stored === 'auto' ? system : 'light';
		document.documentElement.dataset.theme = theme;
		return { updatePickers() {} };
	})();
</script>
