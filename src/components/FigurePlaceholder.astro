---
interface Props {
  figureId?: string;
  title: string;
  caption?: string;
  aspectRatio?: string;
}

const {
  figureId,
  title,
  caption = "Figure to be added upon experimental data consolidation.",
  aspectRatio = "16 / 9"
} = Astro.props;
---

<div class="figure-placeholder-box">
  <div class="figure-icon">
    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <polyline points="21 15 16 10 5 21"></polyline>
    </svg>
  </div>
  <p class="figure-title">{figureId ? `Figure ${figureId}: ` : ""}{title}</p>
  <p class="figure-note">[Image / Vector Asset Placeholder — Content to be supplied]</p>
  {caption && <p class="figure-caption-text">Caption: {caption}</p>}
</div>
